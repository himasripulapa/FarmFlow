<div class="card" style="text-align: center; max-width: 500px; margin: 4rem auto; padding: 3rem 2rem;">
  <div style="font-size: 3.5rem; margin-bottom: 1rem;">🔍</div>
  <h1 style="color: var(--primary-green); font-size: 2rem; margin-bottom: 0.5rem;">404 - Not Found</h1>
  <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 2rem;">
    <%= typeof message !== 'undefined' ? message : 'The requested resource or page was not found on this server.' %>
  </p>
  <a href="/" class="btn btn-primary">Return to FarmFlow</a>
</div>
